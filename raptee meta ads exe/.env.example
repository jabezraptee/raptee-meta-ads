# ==============================================================================
# Meta Ads Intelligence - Environment Configuration
# ==============================================================================

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ------------------------------------------------------------------------------
# LLM Configuration (OpenAI-compatible)
# Changing these values automatically switches the model and provider everywhere!
# ------------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=open-mistral-7b

# ------------------------------------------------------------------------------
# Provider Examples (Uncomment and replace with your key):
# ------------------------------------------------------------------------------
# 1. OpenAI:
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 2. Groq (Ultra-fast):
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter (Access to Claude, Llama, DeepSeek):
# LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxx
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-chat

# 4. Mistral AI:
# LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=open-mistral-7b
